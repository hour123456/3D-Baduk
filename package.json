{
  "name": "baduk-3d-master",
  "private": true,
  "version": "4.0.0",
  "description": "고품격 3D 정통 바둑·오목 게임 — 수담(手談) v4.0 (실시간 멀티·관전·초정밀 물리·입문 튜토리얼·모바일 전용 UI)",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "tsc --noEmit && vite build",
    "build:admin": "tsc -p tsconfig.admin.json --noEmit && vite build --config vite.admin.config.ts",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "electron:dev": "concurrently -k \"vite --port 5173\" \"wait-on tcp:5173 && electron . --dev-server\"",
    "electron:start": "npm run build && electron .",
    "electron:pack": "npm run build && electron-builder --dir",
    "electron:pack:admin": "npm run build:admin && electron-builder --config electron-builder.admin.json --dir"
  },
  "build": {
    "appId": "com.antigravity.baduk3d",
    "productName": "3D 정통 바둑",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "electron/preload.cjs",
      "electron/katago-bridge.cjs"
    ],
    "extraResources": [
      {
        "from": "vendor/katago",
        "to": "katago"
      }
    ],
    "win": {
      "target": [
        "dir"
      ],
      "signAndEditExecutable": false
    }
  },
  "dependencies": {
    "mqtt": "^5.16.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/three": "^0.170.0",
    "concurrently": "^9.1.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8",
    "wait-on": "^8.0.1"
  }
}
