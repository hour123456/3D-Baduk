{
  "name": "baduk-3d-master",
  "private": true,
  "version": "1.0.0",
  "description": "고품격 3D 정통 바둑 게임 (한국식·중국식 엄격 규칙, 물리 음향 합성, 5단계 AI, 실시간 온라인 멀티)",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "electron:dev": "concurrently -k \"vite --port 5173\" \"wait-on tcp:5173 && electron . --dev-server\"",
    "electron:start": "npm run build && electron .",
    "electron:pack": "npm run build && electron-builder --dir"
  },
  "build": {
    "appId": "com.antigravity.baduk3d",
    "productName": "3D 정통 바둑",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        "dir"
      ],
      "signAndEditExecutable": false
    }
  },
  "dependencies": {
    "mqtt": "^5.16.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/three": "^0.170.0",
    "concurrently": "^9.1.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8",
    "wait-on": "^8.0.1"
  }
}